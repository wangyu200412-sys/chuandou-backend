    <div class="tooltip" id="tooltip"></div>

    <script>
        const lenis = new Lenis({
            duration: 1.2, 
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), 
            direction: 'vertical',
            gestureDirection: 'vertical',
            smooth: true,
            mouseMultiplier: 1,
            smoothTouch: false,
            touchMultiplier: 2,
            infinite: false,
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);
        const observerOptions = {
            threshold: 0.2,
            rootMargin: "0px 0px -50px 0px"
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.timeline-item').forEach(item => {
            observer.observe(item);
        });
        const seismicData = [
            { id: 'bar1', val: 88, label: '穿斗木构', desc: '柔性抗震，榫卯耗能，墙倒屋不塌' },
            { id: 'bar2', val: 75, label: '抬梁式', desc: '跨度大但节点刚性较强' },
            { id: 'bar3', val: 45, label: '砖混结构', desc: '脆性材料，抗震性能较差' },
            { id: 'bar4', val: 82, label: '现代钢构', desc: '高延性，但成本较高' }
        ];

        const radarData1 = [95, 90, 85, 70, 75, 88]; 
        const radarData2 = [80, 60, 75, 85, 90, 65]; 
        const angles = [Math.PI/2, Math.PI/6, -Math.PI/6, -Math.PI/2, -5*Math.PI/6, 5*Math.PI/6];
        const center = { x: 250, y: 200 };
        const maxRadius = 150;

        function animateBars() {
            seismicData.forEach((item, index) => {
                const bar = document.getElementById(item.id);
                const valText = document.getElementById('val' + (index + 1));
                const targetHeight = (item.val / 100) * 240;
                const targetY = 280 - targetHeight;
                
                let currentHeight = 0;
                let currentY = 280;
                const duration = 1500;
                const startTime = performance.now();
                
                function update(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const ease = 1 - Math.pow(1 - progress, 3);
                    
                    currentHeight = targetHeight * ease;
                    currentY = 280 - currentHeight;
                    
                    bar.setAttribute('height', currentHeight);
                    bar.setAttribute('y', currentY);
                    
                    if (progress === 1) {
                        valText.setAttribute('y', targetY - 10);
                        valText.setAttribute('opacity', '1');
                        valText.textContent = item.val;
                        
                        bar.style.cursor = 'pointer';
                        bar.addEventListener('mouseenter', (e) => showTooltip(e, item));
                        bar.addEventListener('mouseleave', hideTooltip);
                        bar.addEventListener('mousemove', (e) => moveTooltip(e));
                    } else {
                        requestAnimationFrame(update);
                    }
                }
                
                setTimeout(() => requestAnimationFrame(update), index * 200);
            });
        }

        function getRadarPoint(value, angle, radius) {
            const r = (value / 100) * radius;
            return {
                x: center.x + r * Math.cos(angle),
                y: center.y - r * Math.sin(angle)
            };
        }

        function animateRadar() {
            const poly1 = document.getElementById('poly1');
            const poly2 = document.getElementById('poly2');
            
            let progress = 0;
            const duration = 2000;
            const startTime = performance.now();
            
            function update(currentTime) {
                const elapsed = currentTime - startTime;
                progress = Math.min(elapsed / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 3);
                
                const points1 = radarData1.map((val, i) => {
                    const currentVal = val * ease;
                    const point = getRadarPoint(currentVal, angles[i], maxRadius);
                    return `${point.x},${point.y}`;
                }).join(' ');
                
                const points2 = radarData2.map((val, i) => {
                    const currentVal = val * ease;
                    const point = getRadarPoint(currentVal, angles[i], maxRadius);
                    return `${point.x},${point.y}`;
                }).join(' ');
                
                poly1.setAttribute('points', points1);
                poly2.setAttribute('points', points2);
                poly1.setAttribute('opacity', 0.6);
                poly2.setAttribute('opacity', 0.6);
                
                radarData1.forEach((val, i) => {
                    const currentVal = val * ease;
                    const point = getRadarPoint(currentVal, angles[i], maxRadius);
                    const circle = document.getElementById(`p1_${i+1}`);
                    circle.setAttribute('cx', point.x);
                    circle.setAttribute('cy', point.y);
                    circle.setAttribute('opacity', progress > 0.5 ? 1 : 0);
                });
                
                radarData2.forEach((val, i) => {
                    const currentVal = val * ease;
                    const point = getRadarPoint(currentVal, angles[i], maxRadius);
                    const circle = document.getElementById(`p2_${i+1}`);
                    circle.setAttribute('cx', point.x);
                    circle.setAttribute('cy', point.y);
                    circle.setAttribute('opacity', progress > 0.5 ? 1 : 0);
                });
                
                if (progress < 1) {
                    requestAnimationFrame(update);
                }
            }
            
            requestAnimationFrame(update);
        }

        const tooltip = document.getElementById('tooltip');
        
        function showTooltip(e, data) {
            tooltip.innerHTML = `<strong>${data.label}</strong><br/>抗震评分: ${data.val}<br/>${data.desc}`;
            tooltip.style.opacity = '1';
            moveTooltip(e);
        }
        
        function moveTooltip(e) {
            tooltip.style.left = e.pageX + 15 + 'px';
            tooltip.style.top = e.pageY - 10 + 'px';
        }
        
        function hideTooltip() {
            tooltip.style.opacity = '0';
        }
        const dataObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    setTimeout(animateBars, 300);
                    setTimeout(animateRadar, 800);
                    dataObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.3 });

        document.querySelector('.data-section') && dataObserver.observe(document.querySelector('.data-section'));
        document.addEventListener('click', (e) => {
            if (e.target.closest('.chart-container')) {
                animateBars();
                animateRadar();
            }
        });
        if (window.location.hash === '#scientists') {
            setTimeout(() => {
                document.querySelector('.scientists-section').scrollIntoView({ behavior: 'smooth' });
            }, 500);
        }
        const canvas = document.getElementById('ambient-particles');
        const ctx = canvas.getContext('2d');
        let particles = [];
        let width, height;
        let animationFrameId; 

        function initParticles() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            particles = [];
            const particleCount = Math.floor(width / 20); 

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    size: Math.random() * 2 + 1,          
                    speedY: Math.random() * 0.4 + 0.1,    
                    speedX: Math.random() * Math.PI * 2,  
                    life: Math.random() * Math.PI * 2,    
                    lifeSpeed: Math.random() * 0.01 + 0.005
                });
            }
        }

        function animateParticles() {
            ctx.clearRect(0, 0, width, height);

            particles.forEach(p => {
                p.y -= p.speedY;
                p.x += Math.sin(p.speedX) * 0.3;
                p.speedX += 0.01;
                p.life += p.lifeSpeed;
                const opacity = (Math.sin(p.life) * 0.5 + 0.5) * 0.8; 
                if (p.y < -10) {
                    p.y = height + 10;
                    p.x = Math.random() * width;
                    p.life = -Math.PI / 2;
                }
                ctx.fillStyle = `rgba(212, 175, 55, ${opacity})`;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
            });
            animationFrameId = requestAnimationFrame(animateParticles);
        }

        window.addEventListener('resize', initParticles);
        initParticles();
        const heroSection = document.querySelector('.hero');
        const particleObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    animateParticles();
                } else {
                    cancelAnimationFrame(animationFrameId);
                }
            });
        });
        if (heroSection) particleObserver.observe(heroSection);
        const scientistCards = document.querySelectorAll('.scientist-card');
        
        scientistCards.forEach(card => {
            const glare = document.createElement('div');
            glare.classList.add('glare');
            card.appendChild(glare);

            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((centerY - y) / centerY) * 10;
                const rotateY = ((x - centerX) / centerX) * 10;
                card.style.transition = 'none';
                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
                glare.style.opacity = '1';
                glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255, 255, 255, 0.4) 0%, transparent 60%)`;
            });

            card.addEventListener('mouseleave', () => {
                card.style.transition = 'transform 0.5s ease-out, box-shadow 0.4s ease, border-color 0.4s ease';
                card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;
                glare.style.opacity = '0';
            });
        });

        gsap.registerPlugin(ScrollTrigger);
        gsap.to('.timeline', {
            '--line-scale': 1,
            ease: "none",
            scrollTrigger: {
                trigger: '.timeline',
                start: "top 80%",   
                end: "bottom 80%",  
                scrub: 1
            }
        });
        const items = gsap.utils.toArray('.timeline-item');
        items.forEach((item, index) => {
            const content = item.querySelector('.timeline-content');
            const elements = item.querySelectorAll('.era-title, .era-period, .era-desc, .feature-tags');
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: item,
                    start: "top 85%", 
                    toggleActions: "play none none reverse" 
                }
            });
            tl.fromTo(item, 
                { opacity: 0 }, 
                { opacity: 1, duration: 0.1 }
            ).fromTo(content,
                { opacity: 0, scale: 0.95 },
                { opacity: 1, scale: 1, duration: 0.8, ease: "power2.out" }
            )
            .fromTo(elements,
                { y: 30, opacity: 0 },
                { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "back.out(1.2)" },
                "-=0.5"
            );
            gsap.to(content, {
                '--watermark-y': '60px', 
                ease: "none",
                scrollTrigger: {
                    trigger: item,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 1
                }
            });
        });
        const dots = document.querySelectorAll('.timeline-dot');
        dots.forEach(dot => {
            const parent = dot.closest('.timeline-item');
            gsap.set(dot, { xPercent: -50, x: 0, y: 0 });

            parent.addEventListener('mousemove', (e) => {
                const rect = parent.getBoundingClientRect();
                const dotCenterX = rect.left + rect.width / 2;
                const dotCenterY = rect.top + 40; 
                
                const distX = e.clientX - dotCenterX;
                const distY = e.clientY - dotCenterY;
                const distance = Math.sqrt(distX * distX + distY * distY);
                if (distance < 150) {
                    gsap.to(dot, {
                        x: distX * 0.4,
                        y: distY * 0.4,
                        duration: 0.4,
                        ease: "power2.out",
                        overwrite: "auto"
                    });
                } else {
                    gsap.to(dot, {
                        x: 0,
                        y: 0,
                        duration: 0.8,
                        ease: "elastic.out(1, 0.3)",
                        overwrite: "auto"
                    });
                }
            });

            parent.addEventListener('mouseleave', () => {
                gsap.to(dot, {
                    x: 0,
                    y: 0,
                    duration: 0.8,
                    ease: "elastic.out(1, 0.3)",
                    overwrite: "auto"
                });
            });
        });
    </script>
</body>
</html>