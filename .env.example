# 环境配置示例（本地开发用；生产环境请在 Render Dashboard 的 Environment 中设置）

# 运行环境：本地 development，部署生产 production
FLASK_ENV=development

# 密钥：本地可用任意值；生产必须设置强随机值
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-local-development-key
JWT_SECRET_KEY=change-me-local-development-jwt-key

# 数据库配置
# 本地 SQLite（默认）
DATABASE_URL=sqlite:///chuandou.db
# Supabase 生产示例（Session pooler，端口 5432，适合 IPv4 环境）
# DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:5432/postgres

# 文件上传配置
MAX_CONTENT_LENGTH=16777216
# 本地默认项目内 uploads；Render 免费实例默认 /tmp/uploads
# UPLOAD_FOLDER=uploads
# local：保存到本地（云端为临时存储）；disabled：关闭上传
UPLOAD_STORAGE=local

# 跨域：前后端同源部署留空；独立前端域名时填写，多个用逗号分隔
# CORS_ORIGINS=https://your-frontend-domain.com

# 百度内容审核（可选，留空且 AI_CONTENT_CHECK=false 时不做拦截）
# AI_API_KEY=
# AI_SECRET_KEY=
# AI_CONTENT_CHECK=false

# 可选：启动前自动建表（云端免费实例建议开启）
# INIT_DB_ON_START=false
